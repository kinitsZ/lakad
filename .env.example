# Local Postgres, or a Supabase connection string.
#
# Supabase → Connect → "Transaction pooler". Note the username carries the
# project ref, and the host is pooler.supabase.com, NOT db.<ref>.supabase.co —
# the direct db.<ref> host is IPv6-only and unreachable on most home networks.
#   postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
# URL-encode the password if it contains @ : / ? # or %
#
# Locally, prefer the "Session pooler" (same host, port 5432): it supports prepared
# statements, which halves the round trips per query. Keep 6543 on serverless hosts.
DATABASE_URL="postgresql://zymerkinits@localhost:5432/tripsync"

# Optional. Migrations run DDL, which the transaction pooler doesn't fully
# support — point this at the "Session pooler" (same host, port 5432).
# Falls back to DATABASE_URL when unset.
# MIGRATION_DATABASE_URL=""

# Optional: max connections in the pool (keep low on Supabase's free tier).
DATABASE_POOL_MAX="5"

# Shared secret for POST /api/automations/tick (the n8n schedule hook).
AUTOMATION_SECRET="change-me"
